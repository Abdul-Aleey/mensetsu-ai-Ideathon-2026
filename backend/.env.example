# Copy this file to .env for local development. Never commit .env itself
# (it's in .gitignore). In production, set these as Cloud Run env vars
# directly — do not use this file there.

# --- Avatar ---
# Options: mock | perxona
#   mock    — browser speechSynthesis/SpeechRecognition, zero Perxona credits (default)
#   perxona — real avatar via the Perxona Presenter SDK, costs Perxona credits
AVATAR_MODE=mock
# Perxona Connect account credentials (NOT the same as the old <sv-agent>
# widget's domain-scoped apiKey — this is a separate email/password account
# our backend logs into to mint a short-lived bearer token for the
# Presenter SDK's present() calls; see app/services/perxona_connect.py).
# Create one via POST /api/v1/connect/auth/signup + confirm-signup — see
# https://github.com/XRSPACE-Inc/perxona-connect-kit for the full flow.
PERXONA_CONNECT_EMAIL=
PERXONA_CONNECT_PASSWORD=
# Region-specific Connect API base URL. No fixed set — use your region's.
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
# Presenter engine script URL (CDN). Region-scoped — the /asia/ segment
# matters, the same way it did for the old <sv-agent> CDN URL (omitting it
# defaults to the "eu" region and 401s against an asia-region account).
PERXONA_PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js
# Avatar/scene/voice IDs from Perxona's Connect asset catalog (GET
# /api/v1/connect/assets/avatars, /assets/scenes, /voices) — a different
# catalog from the old ai-avatar Storyboard system. Defaults below were
# chosen to match the original "Alex" persona as closely as this catalog
# allows: cc006_male_finance (navy suit), sova_Interior_13 (a warm marble
# reception/lobby — deliberately different from Sara's own scene, see
# app/config.py), and the same "Male - warm and expressive" voice.
PERXONA_PRESENTER_AVATAR_ID=01K4M8SH17VHBRTXWEB2KKYPCS
PERXONA_PRESENTER_SCENE_ID=01K87XYCZ1H1QJ1J28NMZN8WEP
PERXONA_PRESENTER_VOICE_ID=01KWV12DBD8VTFA4YXJ4AHCCHR

# --- Gemini / Vertex AI ---
# Options: true | false
# app/services/gemini_client.py already passes vertexai=True explicitly to the
# genai.Client, so this is redundant for that call — set anyway as a defensive
# fallback/consistency with the proven deploy pattern.
GOOGLE_GENAI_USE_VERTEXAI=true
# Any Gemini model id available in Vertex AI Model Garden for your project/region.
# Check the current list at https://console.cloud.google.com/vertex-ai/model-garden
# since availability changes over time — as of writing, common options include:
#   gemini-2.0-flash       — fast/cheap, good for JSON-mode agent calls
#   gemini-2.0-flash-lite  — even cheaper/faster, lower quality
#   gemini-2.5-flash       — stronger reasoning than 2.0-flash
#   gemini-2.5-pro         — highest quality, slower and more expensive
#   gemini-3.5-flash       — confirmed available in asia-northeast1 (current default)
GEMINI_MODEL=gemini-3.5-flash
# Your GCP project ID (not project number, not project name). No fixed set.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Any Vertex AI region that serves Gemini. Common options:
#   asia-northeast1  — Tokyo (default here — closest to our Japanese hiring market)
#   asia-southeast1  — Singapore
#   us-central1      — Iowa (often first to get new model previews)
#   us-east4         — Virginia
#   europe-west4     — Netherlands
# Full current list: https://cloud.google.com/vertex-ai/docs/general/locations
GOOGLE_CLOUD_LOCATION=asia-northeast1

# --- Data ---
# Database is a fixed local SQLite file (backend/mensetsu.db) — not
# configurable via env var. Fine for a single concurrent user; would need
# to become a real Postgres/Cloud SQL setup (with code changes in
# app/database.py) before this could handle concurrent traffic safely on
# Cloud Run's multi-instance, ephemeral-disk model.
# PDF report storage bucket (stored under an "avatar-hack/" prefix inside it,
# see app/services/storage.py). No fixed set — any GCS bucket name you own.
# Leave blank for local dev (falls back to local disk under generated_pdfs/).
# Set this once deployed to Cloud Run — local disk isn't shared across
# instances or persistent across restarts, so a report generated on one
# instance can 404 on another without it.
GCS_BUCKET=your-gcs-bucket-name
